# FixCare Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Database
# For local development with docker-compose:
DATABASE_URL=postgresql+asyncpg://fixcare:fixcare_dev_password@localhost:5432/fixcare

# AI Provider (mock, openai, gemini, anthropic)
AI_PROVIDER=mock

# AI API Keys (required for non-mock providers)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Authentication
JWT_SECRET=dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=10080

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://10.0.2.2:8080"]

# Logging
LOG_LEVEL=DEBUG

# AI Settings
AI_REQUEST_TIMEOUT=30.0
AI_MAX_RETRIES=2
AI_MAX_TOKENS=2000